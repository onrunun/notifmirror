root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{swift}]
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_style = space
indent_size = 4
ij_kotlin_allow_trailing_comma = true

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{json,xml,plist,md}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
